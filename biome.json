			"onbeforeprint",
			"oncontextrestored",
			"onloadedmetadata",
			"onpointerup",
			"onlanguagechange",
			"oncopy",
			"onselectstart",
			"onscroll",
			"onload",
			"ondragstart",
			"onbeforeinput",
			"oncanplaythrough",
			"oninput",
			"oninvalid",
			"ontimeupdate",
			"ondurationchange",
			"onselectionchange",
			"onmouseup",
			"location",
			"onkeypress",
			"onpointerleave",
