			"module",
			"require",
			"exports",
			"console",
			"setTimeout",
			"clearTimeout",
			"setInterval",
			"clearInterval",
			"fetch",
			"requestAnimationFrame",
			"cancelAnimationFrame"
		]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}
